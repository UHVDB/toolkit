/*
 * University of Washington Hyak HPC profile.
 *
 * Large --run_update jobs (vClust / kmer-db / DIAMOND / MCL) use process_super_high
 * (24 CPUs, 144 GB, 12 h). resourceLimits must remain at or above those requests.
 *
 * Failures terminate the run after one retry so ignored tasks cannot silently
 * drop batches during classify through aaicluster.
 */
params {
    config_profile_description = "Example config profile used for the University of Washington's Hyak HPC."
    config_profile_contact = 'Carson J. Miller (@CarsonJM)'
    config_profile_url = 'https://hyak.uw.edu/'
    hyak_partition  = 'stf'
    hyak_queue      = 'cpu-g2-mem2x'
}

process {
    executor            = 'slurm'
    clusterOptions      = "-A ${params.hyak_partition} --requeue"
    containerOptions    = "-B /mmfs1/ -B /gscratch/"
    queue               = { ( task.time <= '5.h' as Duration ) ? "ckpt" : "${params.hyak_queue}" }
    // Must be a valid ErrorStrategy enum: retry | ignore | finish | terminate
    // ('fail' is not valid and crashes the head process with IllegalArgumentException)
    errorStrategy       = { (task.attempt <= task.maxRetries) ? 'retry' : 'terminate' }
    maxRetries          = 2
    maxErrors           = -1

    // Cover process_super_high (24 CPUs / 144 GB); raise further if nodes allow
    resourceLimits = [
        cpus: 24,
        memory: '250.GB',
        time: '24.h'
    ]

    withLabel: 'process_gpu' {
        clusterOptions  = { task.attempt == 1 ? "-A pedslabs --requeue --gpus=1" : "-A stf --requeue --gpus-per-node=a40:1" }
        queue           = 'ckpt'
        // Keep filesystem binds; --nv alone would replace the global containerOptions
        containerOptions = "-B /mmfs1/ -B /gscratch/ --nv"
    }
}

executor {
    queueSize = 250
    submitRateLimit = '1 sec'
}

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = 60.m
    cacheDir   = "${params.dbdir}/.singularity-cache/"
}

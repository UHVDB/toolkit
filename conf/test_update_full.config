/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for a larger UHVDB update test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Twenty Illumina paired WGS human metagenomes released after 2026-01-01,
    run against the full UHVDB v6 update database.

    Use as follows:
        nextflow run UHVDB/toolkit -profile test_update_full,uw_hyak --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test update full profile'
    config_profile_description = 'Twenty ENA human metagenomes (first public after 2026-01-01) against the full UHVDB update database'

    // Input data
    input                      = "${projectDir}/assets/test_datasets/samplesheet/test_update_full.csv"
    dbdir                      = "test_databases"
    uhvdb_version              = 'v6'
    bakta_db_version           = 'full'

    // Pipeline options
    run_update                 = true
    include_coassembly         = true
}

nextflow_process {

    name "Test Process CSVTK_FILTER2"
    script "../main.nf"
    process "CSVTK_FILTER2"

    tag "modules"
    tag "modules_local"
    tag "csvtk"
    tag "csvtk/filter2"

    test("filter - integration") {

        config "./filter.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/filter_input.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("filter - stub") {

        options "-stub"
        config "./filter.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/filter_input.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

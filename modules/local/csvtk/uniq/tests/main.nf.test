nextflow_process {

    name "Test Process CSVTK_UNIQ"
    script "../main.nf"
    process "CSVTK_UNIQ"

    tag "modules"
    tag "modules_local"
    tag "csvtk"
    tag "csvtk/uniq"

    test("uniq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/filter_input.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

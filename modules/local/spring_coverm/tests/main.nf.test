nextflow_process {

    name "Test Process SPRING_COVERM"
    script "../main.nf"
    process "SPRING_COVERM"

    tag "modules"
    tag "modules_local"
    tag "spring_coverm"

    test("single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                             file("${projectDir}/assets/test_datasets/nf-test/spring/test.spring"),
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

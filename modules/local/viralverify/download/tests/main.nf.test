nextflow_process {

    name "Test Process VIRALVERIFY_DOWNLOAD"
    script "../main.nf"
    process "VIRALVERIFY_DOWNLOAD"

    tag "modules"
    tag "modules_local"
    tag "viralverify"
    tag "viralverify/download"

    test("stub") {

        options "-stub"

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("full_test") {

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

nextflow_process {

    name "Test Process GENOMAD_DOWNLOADHALLMARKS"
    script "../main.nf"
    process "GENOMAD_DOWNLOADHALLMARKS"

    tag "modules"
    tag "modules_local"
    tag "genomad"
    tag "genomad/downloadhallmarks"

    test("download - stub") {

        options "-stub"

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

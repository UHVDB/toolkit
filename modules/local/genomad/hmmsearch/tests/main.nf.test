nextflow_process {

    name "Test Process GENOMAD_HMMSEARCH"
    script "../main.nf"
    process "GENOMAD_HMMSEARCH"

    tag "modules"
    tag "modules_local"
    tag "genomad"
    tag "genomad/hmmsearch"

    test("uncertain viruses - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz") ]
                input[1] = file("${params.local_testdata_base_path}/hmm/virus.hmm")
                input[2] = file("${params.local_testdata_base_path}/tsv/genomad_markers.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

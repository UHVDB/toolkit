nextflow_process {

    name "Test Process DEACON_INDEXFETCH"
    script "../main.nf"
    process "DEACON_INDEXFETCH"

    tag "modules"
    tag "modules_local"
    tag "deacon"
    tag "deacon/indexfetch"

    test("panhuman-1") {

        when {
            process {
                """
                input[0] = 'panhuman-1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.idx[0]).name,
                    file(process.out.idx[0]).length()
                    ).match() 
                }
            )
        }
    }

    test("panhuman-1 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'panhuman-1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

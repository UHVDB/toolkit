nextflow_process {

    name "Test Process SEQKIT_SEQ_REPLACE_SPLIT2"
    script "../main.nf"
    process "SEQKIT_SEQ_REPLACE_SPLIT2"

    tag "modules"
    tag "modules_local"
    tag "seqkit"
    tag "seqkit/seq_replace_split2"

    test("lambda") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${projectDir}/assets/test_datasets/fna/lambda.fna.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("lambda - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${projectDir}/assets/test_datasets/fna/lambda.fna.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

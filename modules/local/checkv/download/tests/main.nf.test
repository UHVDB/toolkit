nextflow_process {

    name "Test Process CHECKV_DOWNLOAD"
    script "../main.nf"
    process "CHECKV_DOWNLOAD"

    tag "modules"
    tag "modules_local"
    tag "checkv"
    tag "checkv/download"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'https://s3.kopah.uw.edu/uhvdb-checkv/v5.1/'
                input[1] = 'https://zenodo.org/records/21229765/files/uhvdb_checkv_5.1.tar.gz?download=1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("s3") {

        when {
            process {
                """
                input[0] = 'https://s3.kopah.uw.edu/uhvdb-checkv/v5.1/'
                input[1] = 'https://zenodo.org/records/21229765/files/uhvdb_checkv_5.1.tar.gz?download=1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def checkvDb = path(process.out.checkv_db[0])
                    def root = checkvDb.toString()
                    def fileNames = []
                    new File(root).eachFileRecurse(groovy.io.FileType.FILES) { f ->
                        fileNames.add(f.toString().replaceFirst("${root}/", ''))
                    }
                    fileNames.sort()

                    def checkvRepsContent = path("${root}/genome_db/checkv_reps.tsv").text

                    assert snapshot(fileNames, checkvRepsContent).match()
                }
            )
        }
    }

    test("zenodo") {

        when {
            process {
                """
                input[0] = 'https://s3.kopah.uw.edu/uhvdb-checkv/nonexistent/'
                input[1] = 'https://zenodo.org/records/21229765/files/uhvdb_checkv_5.1.tar.gz?download=1'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def checkvDb = path(process.out.checkv_db[0])
                    def root = checkvDb.toString()
                    def fileNames = []
                    new File(root).eachFileRecurse(groovy.io.FileType.FILES) { f ->
                        fileNames.add(f.toString().replaceFirst("${root}/", ''))
                    }
                    fileNames.sort()

                    def checkvRepsContent = path("${root}/genome_db/checkv_reps.tsv").text

                    assert snapshot(fileNames, checkvRepsContent).match()
                }
            )
        }
    }
}

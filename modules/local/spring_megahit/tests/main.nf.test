nextflow_process {

    name "Test Process SPRING_MEGAHIT"
    script "../main.nf"
    process "SPRING_MEGAHIT"

    tag "modules"
    tag "modules_local"
    tag "spring"
    tag "megahit"
    tag "spring_megahit"

    test("SRR33973430 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ],
                             file("${projectDir}/assets/test_datasets/spring/SRR33973430.spring", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("SRR33973430") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ],
                             file("${projectDir}/assets/test_datasets/spring/SRR33973430.spring", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

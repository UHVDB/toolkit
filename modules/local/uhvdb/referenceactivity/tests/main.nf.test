nextflow_process {

    name "Test Process UHVDB_REFERENCEACTIVITY"
    script "../main.nf"
    process "UHVDB_REFERENCEACTIVITY"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/referenceactivity"

    test("referenceactivity - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', group:'test' ],
                             file("${params.local_testdata_base_path}/tsv/sylph_tax.tsv.gz"),
                             file("${params.local_testdata_base_path}/tsv/coverm.tsv.gz") ]
                input[1] = file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz")
                input[2] = file("${params.local_testdata_base_path}/stub/referenceactivity_model.pkl")
                input[3] = file("${params.local_testdata_base_path}/tsv/referenceactivity_metadata.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

nextflow_process {

    name "Test Process UHVDB_PRUNE"
    script "../main.nf"
    process "UHVDB_PRUNE"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/prune"

    test("prune - integration") {

        when {
            process {
                """
                input[0] = [ [ id:'subfamily' ],
                             file("${params.local_testdata_base_path}/tsv/normscore_graph.tsv.gz"),
                             file("${params.local_testdata_base_path}/tsv/mcl_subfamily.mcl.gz") ]
                input[1] = 5.0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("prune - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'subfamily' ],
                             file("${params.local_testdata_base_path}/tsv/normscore_graph.tsv.gz"),
                             file("${params.local_testdata_base_path}/tsv/mcl_subfamily.mcl.gz") ]
                input[1] = 5.0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

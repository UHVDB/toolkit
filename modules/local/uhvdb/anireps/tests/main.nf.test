nextflow_process {

    name "Test Process UHVDB_ANIREPS"
    script "../main.nf"
    process "UHVDB_ANIREPS"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/anireps"

    test("anireps - integration") {

        config "./anireps.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/uhvdb_new_reps.fna.gz") ]
                input[1] = file("${params.local_testdata_base_path}/fasta/uhvdb_old_reps.fna.gz")
                input[2] = [ [ id:'combined_classify' ],
                             file("${params.local_testdata_base_path}/tsv/classify_uhvdb.tsv.gz") ]
                input[3] = [ [ id:'combined_hqfilter' ],
                             file("${params.local_testdata_base_path}/tsv/completeness_uhvdb.tsv.gz") ]
                input[4] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/mcl_anireps.mcl.gz") ]
                input[5] = file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("anireps - stub") {

        options "-stub"
        config "./anireps.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/uhvdb_new_reps.fna.gz") ]
                input[1] = file("${params.local_testdata_base_path}/fasta/uhvdb_old_reps.fna.gz")
                input[2] = [ [ id:'combined_classify' ],
                             file("${params.local_testdata_base_path}/tsv/classify_uhvdb.tsv.gz") ]
                input[3] = [ [ id:'combined_hqfilter' ],
                             file("${params.local_testdata_base_path}/tsv/completeness_uhvdb.tsv.gz") ]
                input[4] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/mcl_anireps.mcl.gz") ]
                input[5] = file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

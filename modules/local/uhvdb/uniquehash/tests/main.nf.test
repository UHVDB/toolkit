nextflow_process {

    name "Test Process UHVDB_UNIQUEHASH"
    script "../main.nf"
    process "UHVDB_UNIQUEHASH"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/uniquehash"

    test("uniquehash - integration") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             [ file("${params.local_testdata_base_path}/tsv/seqhasher.tsv.gz") ] ]
                input[1] = file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("uniquehash - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             [ file("${params.local_testdata_base_path}/tsv/seqhasher.tsv.gz") ] ]
                input[1] = file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

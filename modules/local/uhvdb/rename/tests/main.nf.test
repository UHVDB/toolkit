nextflow_process {

    name "Test Process UHVDB_RENAME"
    script "../main.nf"
    process "UHVDB_RENAME"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/rename"

    test("rename - integration") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/classify.tsv.gz") ]
                input[1] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/id_map.tsv.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("rename - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/classify.tsv.gz") ]
                input[1] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/id_map.tsv.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

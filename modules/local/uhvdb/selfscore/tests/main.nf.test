nextflow_process {

    name "Test Process UHVDB_SELFSCORE"
    script "../main.nf"
    process "UHVDB_SELFSCORE"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/selfscore"

    test("selfscore - integration") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/diamond_blast.tsv.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("selfscore - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/diamond_blast.tsv.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

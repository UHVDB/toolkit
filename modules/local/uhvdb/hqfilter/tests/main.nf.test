nextflow_process {

    name "Test Process UHVDB_HQFILTER"
    script "../main.nf"
    process "UHVDB_HQFILTER"

    tag "modules"
    tag "modules_local"
    tag "uhvdb"
    tag "uhvdb/hqfilter"

    test("hq - aai threshold") {

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz"),
                             file("${params.local_testdata_base_path}/tsv/classify.tsv"),
                             file("${params.local_testdata_base_path}/tsv/completeness.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.fna_gz[0][1]).countFasta() >= 1 },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("hq - no matches - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz"),
                             file("${params.local_testdata_base_path}/tsv/classify.tsv"),
                             file("${params.local_testdata_base_path}/tsv/completeness.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

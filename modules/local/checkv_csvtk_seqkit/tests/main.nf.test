nextflow_process {

    name "Test Process CHECKV_SEQKIT_CSVTK_SEQKIT"
    script "../main.nf"
    process "CHECKV_SEQKIT_CSVTK_SEQKIT"

    tag "modules"
    tag "modules_local"
    tag "checkv"
    tag "checkv_csvtk_seqkit"

    test("lambda - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test_batch_0', source_db:'test_db', body_site:'Gut' ],
                    "${projectDir}/assets/test_datasets/fna/lambda.fna.gz"
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("lambda") {

        setup {
            run("CHECKV_DOWNLOAD") {
                script "../../checkv/download/main.nf"
                process {
                    """
                    input[0] = 'https://s3.kopah.uw.edu/uhvdb-checkv/v5.1/'
                    input[1] = "https://zenodo.org/records/21229765/files/uhvdb_checkv_5.1.tar.gz?download=1"
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = [ [ id:'test_batch_0', source_db:'test_db', body_site:'Gut' ],
                    "${projectDir}/assets/test_datasets/fna/lambda.fna.gz"
                ]
                input[1] = CHECKV_DOWNLOAD.out.checkv_db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

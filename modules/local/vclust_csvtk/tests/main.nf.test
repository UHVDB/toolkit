nextflow_process {

    name "Test Process VCLUST_CSVTK"
    script "../main.nf"
    process "VCLUST_CSVTK"

    tag "modules"
    tag "modules_local"
    tag "vclust_csvtk"

    test("viruses - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

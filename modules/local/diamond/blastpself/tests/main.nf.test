nextflow_process {

    name "Test Process DIAMOND_BLASTPSELF"
    script "../main.nf"
    process "DIAMOND_BLASTPSELF"

    tag "modules"
    tag "modules_local"
    tag "diamond"
    tag "diamond/blastpself"

    test("blastpself - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/fasta/proteins.faa.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

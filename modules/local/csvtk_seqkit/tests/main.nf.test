nextflow_process {

    name "Test Process CSVTK_SEQKIT"
    script "../main.nf"
    process "CSVTK_SEQKIT"

    tag "modules"
    tag "modules_local"
    tag "csvtk"
    tag "seqkit"
    tag "csvtk_seqkit"

    test("filter - integration") {

        config "./filter.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/classify.tsv"),
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }

    test("filter - stub") {

        options "-stub"
        config "./filter.config"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${params.local_testdata_base_path}/tsv/classify.tsv"),
                             file("${params.local_testdata_base_path}/fasta/viruses.fna.gz") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.findAll { key, val -> key.startsWith('versions') == false }).match() }
            )
        }
    }
}

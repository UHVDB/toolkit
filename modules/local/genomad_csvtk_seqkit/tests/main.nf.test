nextflow_process {

    name "Test Process GENOMAD_CSVTK_SEQKIT"
    script "../main.nf"
    process "GENOMAD_CSVTK_SEQKIT"

    tag "modules"
    tag "modules_local"
    tag "genomad"
    tag "genomad_csvtk_seqkit"

    test("lambda") {

        setup {
            run("GENOMAD_DOWNLOAD") {
                script "../../../nf-core/genomad/download/main.nf"
            }
        }

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${projectDir}/assets/test_datasets/fna/lambda.fna.gz", checkIfExists: true) ]
                input[1] = GENOMAD_DOWNLOAD.out.genomad_db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("lambda - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                             file("${projectDir}/assets/test_datasets/fna/lambda.fna.gz", checkIfExists: true) ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

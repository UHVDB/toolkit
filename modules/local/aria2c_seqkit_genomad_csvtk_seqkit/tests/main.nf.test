nextflow_process {

    name "Test Process ARIA2C_SEQKIT_GENOMAD_CSVTK_SEQKIT"
    script "../main.nf"
    process "ARIA2C_SEQKIT_GENOMAD_CSVTK_SEQKIT"

    tag "modules"
    tag "modules_local"
    tag "aria2c"
    tag "genomad"
    tag "aria2c_seqkit_genomad_csvtk_seqkit"

    test("sarscov2") {

        setup {
            run("GENOMAD_DOWNLOAD") {
                script "../../../nf-core/genomad/download/main.nf"
            }
        }

        when {
            process {
                """
                input[0] = [ [ id:'test_batch_0', source_db:'test_db', body_site:'Gut' ],
                             [ [ 'sample1', "https://github.com/nf-core/test-datasets/raw/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta.gz" ] ] ]
                input[1] = GENOMAD_DOWNLOAD.out.genomad_db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test_batch_0', source_db:'test_db', body_site:'Gut' ],
                             [ [ 'sample1', "https://github.com/nf-core/test-datasets/raw/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta.gz" ] ] ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

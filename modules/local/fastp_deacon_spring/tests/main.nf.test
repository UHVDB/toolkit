nextflow_process {

    name "Test Process FASTP_DEACON_SPRING"
    script "../main.nf"
    process "FASTP_DEACON_SPRING"

    tag "modules"
    tag "modules_local"
    tag "fastp_deacon_spring"

    test("single_end") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                             [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true) ] ]
                input[1] = file("${projectDir}/assets/test_datasets/idx/lambda.idx")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.spring[0][1]).name
                    ).match()
                }
            )
        }
    }

    test("single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ],
                             [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true) ] ]
                input[1] = file("${projectDir}/assets/test_datasets/idx/lambda.idx")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("paired_end") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ],
                             [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true),
                               file("${projectDir}/assets/test_datasets/fastq/SRR33973430_2.fastq.gz", checkIfExists: true) ] ]
                input[1] = file("${projectDir}/assets/test_datasets/idx/lambda.idx")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.spring[0][1]).name
                    ).match()
                }
            )
        }
    }

    test("paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:false ],
                             [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true),
                               file("${projectDir}/assets/test_datasets/fastq/SRR33973430_2.fastq.gz", checkIfExists: true) ] ]
                input[1] = file("${projectDir}/assets/test_datasets/idx/lambda.idx")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

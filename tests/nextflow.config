/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/toolkit/'
    local_testdata_base_path = "${projectDir}/assets/test_datasets"

    // Pipeline test params
    uhvdb_version              = 'test'
    checkv_s3                  = 'https://s3.kopah.uw.edu/uhvdb-checkv/v5.1/checkv_db.tar.gz'
    checkv_zenodo              = 'https://zenodo.org/api/records/21229765/files/uhvdb_checkv_5.1.tar.gz/content'
    deacon_index_name          = 'panhuman-1'
    min_checkv_update          = 2
}

process {
    // Override nf-core base.config default (ignore) so failed module tests fail nf-test
    errorStrategy = 'terminate'

    withName: SPRING_MEGAHIT {
        cpus = 1
    }

    withName: '.*UHVDB_DOWNLOAD' {
        errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withName: '.*CHECKV_DOWNLOAD' {
        errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withName: '.*UHBDB_DOWNLOAD' {
        errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    withName: 'SEQKIT_SEQ_REPLACE_SPLIT2' {
        ext.args = [
            "--remove-gaps",
            "--upper-case",
            "--validate-seq",
            "--min-len 2000",
        ].join(' ').trim()
        ext.args2 = { "--pattern '^' --replacement ${meta.id}_" }
        ext.args3 = { "--by-size 10000" }
    }

    withName: '.*CHECKV_VIRALVERIFY_CLASSIFY' {
        ext.args = [
            "--relaxed --splits 5",
        ].join(' ').trim()
        ext.args2 = [
            "--tabs",
            "--filter",
            "'( ( \$virus_score >= 0.7 && \$length >= 2000 ) || ( \$taxonomy =~ \"Inoviridae\" ) ) &&",
            "!( \$taxonomy =~ \"Caudoviricetes\" && \$length < 10000 ) &&",
            "!( \$taxonomy =~ \"Inoviridae\" && ( \$length < 4500 || \$length > 12500 ) ) &&",
            "!( \$taxonomy == \"Unclassified\" ) &&",
            "( ( \$taxonomy =~ \"viricetes\" ) || ( \$taxonomy =~ \"Anelloviridae\" ) )'",
            "| csvtk cut --tabs -f seq_name --out-delimiter '\t'"
        ].join(' ').trim()
        ext.args3 = [
            "--tabs",
            "--filter",
            "'( \$aai_completeness >= 50 ) &&",
            "( \$kmer_freq <= 1.2 ) &&",
            "( \$contig_length / \$aai_expected_length <= 1.5 )'",
            "| csvtk cut --tabs -f contig_id --out-delimiter '\t'"
        ].join(' ').trim()
    }

    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

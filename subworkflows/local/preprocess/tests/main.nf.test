nextflow_workflow {

    name "Test Subworkflow PREPROCESS"
    script "../main.nf"
    workflow "PREPROCESS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/preprocess"

    test("human - single - SRR33973430") {

        when {
            workflow {
                """
                input[0] = 'panhuman-1'
                input[1] = [ [ id:'test', single_end:true ],
                    [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true) ] ]
                input[2] = [ [ id:'test', single_end:true ], 'SRR33973430' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(file(workflow.out.spring[0][1]).name).match() }
            )
        }
    }

    test("human - single - SRR33973430 - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = 'panhuman-1'
                input[1] = [ [ id:'test', single_end:true ],
                    [ file("${projectDir}/assets/test_datasets/fastq/SRR33973430_1.fastq.gz", checkIfExists: true) ] ]
                input[2] = [ [ id:'test', single_end:true ], 'SRR33973430' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

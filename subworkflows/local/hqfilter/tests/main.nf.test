nextflow_workflow {

    name "Test Subworkflow HQFILTER"
    script "../main.nf"
    workflow "HQFILTER"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/hqfilter"

    test("viruses - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/fasta/viruses.fna.gz")
                ])
                input[1] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/fasta/viruses.fna.gz")
                ])
                input[2] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/tsv/classify.tsv.gz")
                ])
                input[3] = Channel.value(file("${projectDir}/assets/test_datasets/nf-test/checkv/db"))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

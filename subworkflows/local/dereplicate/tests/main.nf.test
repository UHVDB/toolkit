nextflow_workflow {

    name "Test Subworkflow DEREPLICATE"
    script "../main.nf"
    workflow "DEREPLICATE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/dereplicate"

    test("hq viruses - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/fasta/viruses.fna.gz")
                ])
                input[1] = Channel.of([
                    [ id:'combined_classify' ],
                    file("${params.local_testdata_base_path}/tsv/classify_uhvdb.tsv.gz")
                ])
                input[2] = Channel.of([
                    [ id:'combined_hqfilter' ],
                    file("${params.local_testdata_base_path}/tsv/completeness_uhvdb.tsv.gz")
                ])
                input[3] = Channel.value(file("${params.local_testdata_base_path}/fasta/uhvdb_old_reps.fna.gz"))
                input[4] = Channel.value(file("${params.local_testdata_base_path}/tsv/gani_graph.tsv.gz"))
                input[5] = Channel.value(file("${params.local_testdata_base_path}/tsv/uhvdb_metadata.tsv.gz"))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

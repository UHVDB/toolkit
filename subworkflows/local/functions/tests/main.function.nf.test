nextflow_function {

    name "Test Functions"
    script "subworkflows/local/functions/main.nf"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/functions"

    test("extractDigitBeforeExtension - split suffix") {

        function "extractDigitBeforeExtension"

        when {
            function {
                """
                input[0] = "sample_split1.fasta.gz"
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == "1" }
            )
        }
    }

    test("extractDigitBeforeExtension - no match") {

        function "extractDigitBeforeExtension"

        when {
            function {
                """
                input[0] = "sample.fasta.gz"
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("add_split - appends split id") {

        function "add_split"

        when {
            function {
                """
                input[0] = [ id:'sample', single_end:true ]
                input[1] = "sample_split2.fna.gz"
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.id == "sample_split2" }
            )
        }
    }
}

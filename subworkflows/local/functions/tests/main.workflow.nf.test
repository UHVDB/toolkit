nextflow_workflow {

    name "Test Functions Workflow"
    script "./test_workflow.nf"
    workflow "TEST_FUNCTIONS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/functions"

    test("rmEmptyFastAs - filters empty fasta - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/fasta/viruses.fna.gz")
                ])
                input[1] = Channel.of([
                    [ id:'empty' ],
                    file("${projectDir}/assets/test_datasets/nf-test/fasta/empty.fna.gz")
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

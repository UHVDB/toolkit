nextflow_workflow {

    name "Test Subworkflow HCFILTER"
    script "../main.nf"
    workflow "HCFILTER"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/hcfilter"

    test("hq viruses - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/fasta/viruses.fna.gz")
                ])
                input[1] = Channel.of([
                    [ id:'test' ],
                    file("${params.local_testdata_base_path}/tsv/classify.tsv.gz")
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

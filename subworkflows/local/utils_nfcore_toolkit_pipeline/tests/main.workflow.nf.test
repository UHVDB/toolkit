nextflow_workflow {

    name "Test Workflow PIPELINE_INITIALISATION"
    script "../main.nf"
    config "./nextflow.config"
    workflow "PIPELINE_INITIALISATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_toolkit_pipeline"
    tag "subworkflows/utils_nfcore_toolkit_pipeline"

    test("samplesheet - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "${projectDir}/results"
                input[5] = "${params.input}"
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
